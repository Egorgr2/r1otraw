# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Shop Configuration
SELLER_USERNAME=your_telegram_username
WEBAPP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SHOP_NAME=Your Shop Name
NEXT_PUBLIC_SELLER_USERNAME=your_telegram_username
NEXT_PUBLIC_SELLER_PHOTO=https://your-photo-url.com/photo.jpg
NEXT_PUBLIC_SELLER_DESCRIPTION=Your seller description

# Logo URL (optional)
LOGO_URL=https://your-logo-url.com/logo.png

# ⚠️ WARNING: Never commit your actual .env file with real credentials!
# Use this .env.example as a template and create your own .env file